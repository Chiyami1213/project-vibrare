---
import Rules from '../content/Rules.astro';
import Terms from '../content/Terms.astro';
import Steps from '../content/Steps.astro';
import DataTable from '../content/DataTable.astro';
import { safeHtml } from '../../scripts/content';
import { titleCase } from '../../scripts/title-case';
import { ANALYSIS, linkFor } from '../../data/fugue';
import type { Topic } from '../../data/fugue';

interface Props {
  topic: Topic;
  /** the topic that holds each tool (a tool is built once on the page) */
  toolHome?: Record<string, { id: string; title: string }>;
}
const { topic: t, toolHome = {} } = Astro.props;
const owner = import.meta.env.DEV; // verification notes are for the owner, in local development only
const toolTitle = (id: string) => ANALYSIS.tools.find((x) => x.id === id)?.title ?? id;
---

<article class="topic-card" id={t.id}>
  <h3>
    {titleCase(t.title)}
    <span class="chip">{titleCase(t.kind)}</span>
  </h3>
  <p class="summary-text"><Fragment set:html={safeHtml(t.summary)} /></p>
  <Steps steps={t.steps} />
  <Terms terms={t.terms} />
  <Rules rules={t.rules} guidelines={t.guidelines} />
  {(t.tables ?? []).map((tb) => <DataTable title={tb.title} columns={tb.columns} rows={tb.rows} note={tb.note} />)}

  {
    (t.cases ?? []).map((c) => (
      <div class="case-card">
        <h4 class="mini-title">
          {c.work}
          <span class={`chip verdict-${c.verdict.replace(/\s+/g, '-')}`}>{titleCase(c.verdict)}</span>
        </h4>
        <ul>{c.properties.map((p) => <li><Fragment set:html={safeHtml(p)} /></li>)}</ul>
        <p><strong>Structure.</strong> <Fragment set:html={safeHtml(c.structure)} /></p>
        <p><strong>Resolution.</strong> <Fragment set:html={safeHtml(c.resolution)} /></p>
      </div>
    ))
  }

  {(t.tools ?? []).map((id) =>
      toolHome[id] && toolHome[id].id !== t.id ? (
        <p class="muted-line">Tool: {toolTitle(id)}, under <a href={`#${toolHome[id].id}`}>{titleCase(toolHome[id].title)}</a>.</p>
      ) : (
        <div class="tool-box" data-ftool={id}><h4 class="mini-title">{toolTitle(id)}</h4></div>
      ),
    )}

  {
    (t.seeAlso ?? []).length > 0 && (
      <p class="see-also">
        See also:{' '}
        {(t.seeAlso ?? []).map((id, i) => {
          const l = linkFor(id);
          return l ? <>{i > 0 && ' · '}<a href={l.href}>{titleCase(l.label)}</a></> : null;
        })}
      </p>
    )
  }

  <footer class="topic-sources">
    {t.sources.map((s) => <span>{s}</span>)}
  </footer>

  {
    owner && (
      <section class="owner-box">
        <h4 class="mini-title">Owner Check (Local Only)</h4>
        <p>Status: <strong>{t.verification.status}</strong></p>
        {t.verification.checks.length > 0 && <ul>{t.verification.checks.map((c) => <li>{c}</li>)}</ul>}
        {(t.verification.flags ?? []).length > 0 && <ul class="flags">{t.verification.flags!.map((f) => <li>{f}</li>)}</ul>}
      </section>
    )
  }
</article>

<script>
  import { mountFugueTools } from '../../scripts/fugue/mount';
  mountFugueTools();
</script>
