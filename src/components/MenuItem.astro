const { item, path, levels = Infinity } = Astro.props;
const norm = (p: string) => p.replace(/\/$/, '') || '/';
const here = norm(path);
const exact = (href: string) => norm(href) === here;
// In this item's section = its own page or any page below it (Home only matches itself).
const inSection = item.href === '/' ? here === '/' : here === norm(item.href) || here.startsWith(norm(item.href) + '/');
const hasSub = !!item.children?.length;
const showSub = hasSub && levels > 0;
---

<li class:list={[{ 'has-sub': showSub, open: hasSub && inSection }]}>
  <a href={item.href} aria-current={exact(item.href) ? 'page' : !hasSub && inSection ? 'true' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[item.icon]} />
    <span class="label">{item.label}</span>
  </a>
  {
    showSub && (
      <div class="sub-wrap">
        <ul class="sub">
          {item.children!.map((c) => <Astro.self item={c} path={path} levels={levels - 1} />)}
        </ul>
      </div>
    )
  }
</li>
