  cof: '<circle cx="12" cy="12" r="9"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/>',
  theory:
    '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  analysis: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  disc: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/>',
  book: '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/>',
  bookmark: '<path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
  stairs: '<path d="M3 20h5v-5h5v-5h5V5h3"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  resolve: '<path d="M3 12h11"/><path d="m10 7 5 5-5 5"/><path d="M20 5v14"/>',
  interval:
    '<circle cx="6" cy="18" r="3"/><circle cx="18" cy="6" r="3"/><path d="M8.2 15.8l7.6-7.6"/>',
  keys: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M9 19v-6M15 19v-6M12 5v8"/>',
  chord:
    '<ellipse cx="8" cy="19" rx="3.8" ry="2"/><ellipse cx="8" cy="12" rx="3.8" ry="2"/><ellipse cx="8" cy="5" rx="3.8" ry="2"/><path d="M11.8 19V3"/>',
  tools:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  music:
    '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  settings:
    '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>',
};

const { item, path, levels = Infinity } = Astro.props;
const norm = (p: string) => p.replace(/\/$/, '') || '/';
const here = norm(path);
const exact = (href: string) => norm(href) === here;
// In this item's section = its own page or any page below it (Home only matches itself).
const inSection = item.href === '/' ? here === '/' : here === norm(item.href) || here.startsWith(norm(item.href) + '/');
const hasSub = !!item.children?.length;
const showSub = hasSub && levels > 0;
---

<li class:list={[{ 'has-sub': showSub, open: hasSub && inSection }]}>
  <a href={item.href} aria-current={exact(item.href) ? 'page' : !hasSub && inSection ? 'true' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[item.icon]} />
    <span class="label">{item.label}</span>
  </a>
  {
    showSub && (
      <div class="sub-wrap">
        <ul class="sub">
          {item.children!.map((c) => <Astro.self item={c} path={path} levels={levels - 1} />)}
        </ul>
      </div>
    )
  }
</li>
