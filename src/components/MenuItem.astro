---
export interface MenuLink {
  href: string;
  label: string;
  icon: string;
  children?: MenuLink[]; // sub-tabs; they can have sub-tabs of their own
}

interface Props {
  item: MenuLink;
  path: string;
  levels?: number; // how many levels of sub-tabs to show below this item (default: all)
}

const ICONS: Record<string, string> = {
  home: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9.5h13V10"/><path d="M10 19.5v-5h4v5"/>',
  score:
    '<path d="M21 15V6"/><circle cx="18.5" cy="15.5" r="2.5"/><path d="M3 12h9M3 6h13M3 18h9"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 12.5 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
  weave: '<path d="M3 8c6 0 6 8 12 8h6"/><path d="M3 16c6 0 6-8 12-8h6"/>',
