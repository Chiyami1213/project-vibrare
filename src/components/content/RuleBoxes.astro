---
import Rules from './Rules.astro';
import { repairTitle } from '../../scripts/content';
import type { ItemInput } from '../../scripts/content';

// The rule boxes of a chapter (counterpoint and fugue): rules in one column, guidelines in the other.
interface Props {
  boxes?: { kind: 'rules' | 'guidelines'; title: string; items: ItemInput[]; note?: ItemInput }[];
}
const { boxes } = Astro.props;
const rules = (boxes ?? []).filter((b) => b.kind === 'rules');
const guides = (boxes ?? []).filter((b) => b.kind === 'guidelines');
---

{
  (boxes ?? []).length > 0 && (
    <div class="rulebox-grid">
      <div>
        {rules.map((b) => <Rules rules={b.items} titles={{ rules: repairTitle(b.title) }} />)}
      </div>
      <div>
        {guides.map((b) => <Rules guidelines={b.items} titles={{ guidelines: repairTitle(b.title) }} />)}
      </div>
    </div>
  )
}
