---
import Layout from '../../layouts/Layout.astro';
import NoteSelect from '../../components/NoteSelect.astro';
import { CHORD_GROUPS } from '../../scripts/theory';
import { CIRCLE, signature, tonicName } from '../../scripts/circle';

// Geometry: 12 segments of 30 degrees, C at the top, clockwise.
const C = 180;
const point = (r: number, deg: number): [number, number] => {
  const a = (deg * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)];
};
const f = (n: number) => n.toFixed(2);
function sector(rOuter: number, rInner: number, i: number) {
  const a0 = -90 + 30 * i - 14.4;
  const a1 = -90 + 30 * i + 14.4;
  const [x0, y0] = point(rInner, a0);
  const [x1, y1] = point(rOuter, a0);
  const [x2, y2] = point(rOuter, a1);
  const [x3, y3] = point(rInner, a1);
  return `M${f(x0)} ${f(y0)}L${f(x1)} ${f(y1)}A${rOuter} ${rOuter} 0 0 1 ${f(x2)} ${f(y2)}L${f(x3)} ${f(y3)}A${rInner} ${rInner} 0 0 0 ${f(x0)} ${f(y0)}Z`;
}
const segments = CIRCLE.flatMap((key, i) => {
  const mid = -90 + 30 * i;
  const sig = key.fifths === 0 ? '0' : `${Math.abs(key.fifths)}${key.fifths > 0 ? '♯' : '♭'}`;
  const [mx, my] = point(146, mid);
  const [sx, sy] = point(127, mid);
  const [nx, ny] = point(92, mid);
  const major = tonicName(i, 'major');
  const minor = tonicName(i, 'minor');
  const count = Math.abs(key.fifths);
  const sigWords = count === 0 ? 'no sharps or flats' : `${count} ${key.fifths > 0 ? 'sharp' : 'flat'}${count > 1 ? 's' : ''}`;
  return [
    { i, mode: 'major', d: sector(170, 118, i), label: major, x: mx, y: my, sig, sx, sy, aria: `${major} major, ${sigWords}` },
    { i, mode: 'minor', d: sector(114, 70, i), label: `${minor}m`, x: nx, y: ny, sig: '', sx: 0, sy: 0, aria: `${minor} minor, ${sigWords}` },
  ];
});
---

<Layout title="Circle of Fifths">
  <main class="calc-page">
    <h1>Circle of Fifths</h1>
    <p class="lead">
      Select a key on the circle to hear its tonic chord. Major keys are on the outer ring and their relative minors
      on the inner ring. Each step clockwise is a fifth up.
    </p>

    <svg class="circle" viewBox="0 0 360 360" role="group" aria-label="Circle of fifths">
      {
        segments.map((s) => (
          <g class={`seg ${s.mode}`} style={`--h:${s.i * 30}`} data-pos={s.i} data-mode={s.mode} role="button" tabindex="0" aria-pressed="false" aria-label={s.aria}>
            <path d={s.d} />
            <text class="seg-name" x={f(s.x)} y={f(s.y)}>{s.label}</text>
            {s.sig && <text class="seg-sig" x={f(s.sx)} y={f(s.sy)}>{s.sig}</text>}
          </g>
        ))
      }
      <g id="shape" class="shape" aria-hidden="true"></g>
      <text id="center-title" class="center-title" x="180" y="176">C major</text>
      <text id="center-sig" class="center-sig" x="180" y="194">no sharps or flats</text>
    </svg>

    <section class="result" aria-live="polite">
      <h2 id="key-title" class="section-title">C major</h2>
      <dl class="facts">
        <div><dt>Key signature</dt><dd id="f-sig"></dd></div>
        <div><dt>Relative key</dt><dd id="f-rel"></dd></div>
        <div><dt id="f-dom-label">Dominant (V)</dt><dd id="f-dom"></dd></div>
        <div><dt id="f-sub-label">Subdominant (IV)</dt><dd id="f-sub"></dd></div>
      </dl>
      <h3 class="mini-title">Scale</h3>
      <div id="scale" class="note-row"></div>
      <div class="btn-row">
        <button type="button" class="btn" id="play-scale">▶ Play scale</button>
        <button type="button" class="btn" id="play-tonic">▶ Play tonic chord</button>
      </div>
      <h3 class="mini-title">Diatonic chords</h3>
      <div class="seg-group" role="group" aria-label="Chord size" id="chord-kind">
        <button type="button" class="seg-btn" data-sevenths="0" aria-pressed="true">Triads</button>
        <button type="button" class="seg-btn" data-sevenths="1" aria-pressed="false">Seventh chords</button>
      </div>
      <p class="muted-line hint">Click a chord to hear it and see its shape on the circle.</p>
      <div id="chords" class="note-row"></div>
    </section>

    <section class="result shape-panel" aria-live="polite">
      <h2 class="section-title">Chord shape</h2>
      <p class="muted-line">
        Each note of a chord has a place on the circle of fifths. Joining them draws the chord's shape: a major or
        minor triad is a lopsided triangle, an augmented triad is an equilateral triangle, and a diminished 7th is
        a square.
      </p>
      <div class="calc-form chord-form">
        <NoteSelect id="shape-root" label="Root" />
        <div class="field">
          <span class="field-label" id="shape-size-label">Chord kind</span>
          <div class="seg-group" role="group" aria-labelledby="shape-size-label" id="shape-sizes">
            {CHORD_GROUPS.map((g) => <button type="button" class="seg-btn" data-kind={g.kind} aria-pressed="false">{g.label}</button>)}
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="shape-chord">Quality</label>
          <select id="shape-chord">
            {CHORD_GROUPS[0].chords.map((c) => <option value={c.id}>{c.name}{c.symbol ? ` (${c.symbol})` : ''}</option>)}
          </select>
        </div>
      </div>
      <div class="btn-row">
        <button type="button" class="btn" id="shape-play">▶ Play chord</button>
        <button type="button" class="btn" id="shape-clear">Clear shape</button>
      </div>
      <p id="shape-caption" class="shape-caption"></p>
    </section>
  </main>

  <script>
    import { CHORDS, CHORD_GROUPS, chordKind } from '../../scripts/theory';
    import { chordInfo, findChord } from '../../scripts/chords';
    import { chordShape, diatonicChordMidis, diatonicChords, keyInfo, scaleMidis, tonicMidis, type Mode } from '../../scripts/circle';
    import { byId, renderChips } from '../../scripts/ui';
    import { playChord } from '../../scripts/synth';

    const segs = [...document.querySelectorAll<SVGGElement>('.seg')];
    const text = (id: string, value: string) => (byId<HTMLElement>(id).textContent = value);
    const wrap = (n: number) => ((n % 12) + 12) % 12;
    const SVG = 'http://www.w3.org/2000/svg';

    let current: { pos: number; mode: Mode } = { pos: 0, mode: 'major' };
    let sevenths = false;
    let shapeChord: { letter: number; alter: number; chordId: string } | null = null;

    // ---- the chord shape drawn on the circle
    const shapeLayer = document.getElementById('shape')!;
    const rootLetter = byId<HTMLSelectElement>('shape-root-letter');
    const rootAcc = byId<HTMLSelectElement>('shape-root-acc');
    const qualitySel = byId<HTMLSelectElement>('shape-chord');
    const sizeBtns = [...document.querySelectorAll<HTMLButtonElement>('#shape-sizes [data-kind]')];

    function fillQualities(kind: string) {
      const group = CHORD_GROUPS.find((g) => g.kind === kind) ?? CHORD_GROUPS[0];
      qualitySel.replaceChildren(
        ...group.chords.map((c) => {
          const o = document.createElement('option');
          o.value = c.id;
          o.textContent = c.symbol ? `${c.name} (${c.symbol})` : c.name;
          return o;
        }),
      );
      qualitySel.dataset.kind = kind;
    }

    function drawShape() {
      shapeLayer.replaceChildren();
      if (!shapeChord) {
        text('shape-caption', 'No chord selected. Click a chord above, or build one here.');
        return;
      }
      const chord = findChord(shapeChord.chordId) ?? CHORDS[0];
      const info = chordInfo(shapeChord.letter, shapeChord.alter, chord, 0);
      const shape = chordShape(info.notes.map((n) => n.midi % 12));
      const R = 118;
      const pts = shape.positions.map((p) => {
        const a = ((-90 + 30 * p) * Math.PI) / 180;
        return [180 + R * Math.cos(a), 180 + R * Math.sin(a)] as const;
      });
      const poly = document.createElementNS(SVG, 'polygon');
      poly.setAttribute('class', 'shape-poly');
      poly.setAttribute('points', pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '));
      shapeLayer.append(poly);
      pts.forEach(([x, y]) => {
        const dot = document.createElementNS(SVG, 'circle');
        dot.setAttribute('class', 'shape-dot');
        dot.setAttribute('cx', x.toFixed(1));
        dot.setAttribute('cy', y.toFixed(1));
        dot.setAttribute('r', '6');
        shapeLayer.append(dot);
      });
      text(
        'shape-caption',
        `${info.symbol} (${info.notes.map((n) => n.name).join(' ')}) makes ${/^[aeiou]/i.test(shape.name) ? 'an' : 'a'} ${shape.name.toLowerCase()}. ` +
          `Steps around the circle between its notes: ${shape.gaps.join(' · ')}.`,
      );
    }

    /** Show a chord in the builder controls and on the circle. */
    function showChord(letter: number, alter: number, chordId: string) {
      shapeChord = { letter, alter, chordId };
      const chord = findChord(chordId) ?? CHORDS[0];
      rootLetter.value = String(letter);
      rootAcc.value = String(alter);
      if (qualitySel.dataset.kind !== chordKind(chord)) fillQualities(chordKind(chord));
      qualitySel.value = chord.id;
      sizeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === chordKind(chord))));
      drawShape();
    }

    // ---- sound: every chord and the scale can be played with the instrument chosen in Settings
    const chordMidis = (letter: number, alter: number, chordId: string) =>
      chordInfo(letter, alter, findChord(chordId) ?? CHORDS[0], 0).notes.map((n) => n.midi);
    const hear = (midis: number[]) => void playChord(midis, 'harmonic');

    byId<HTMLButtonElement>('play-tonic').addEventListener('click', () => hear(tonicMidis(current.pos, current.mode)));
    byId<HTMLButtonElement>('play-scale').addEventListener('click', () => void playChord(scaleMidis(current.pos, current.mode), 'up', { step: 0.34, dur: 0.7 }));
    byId<HTMLButtonElement>('shape-play').addEventListener('click', () => {
      if (shapeChord) hear(chordMidis(shapeChord.letter, shapeChord.alter, shapeChord.chordId));
    });

    function clearChipHighlight() {
      byId<HTMLElement>('chords').querySelectorAll('[aria-pressed]').forEach((c) => c.setAttribute('aria-pressed', 'false'));
    }

    function readBuilder() {
      clearChipHighlight();
      showChord(Number(rootLetter.value), Number(rootAcc.value), qualitySel.value);
    }
    rootLetter.addEventListener('change', readBuilder);
    rootAcc.addEventListener('change', readBuilder);
    qualitySel.addEventListener('change', readBuilder);
    sizeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const group = CHORD_GROUPS.find((g) => g.kind === b.dataset.kind);
        if (!group) return;
        clearChipHighlight();
        showChord(Number(rootLetter.value), Number(rootAcc.value), group.chords[0].id);
      }),
    );
    byId<HTMLButtonElement>('shape-clear').addEventListener('click', () => {
      shapeChord = null;
      clearChipHighlight();
      drawShape();
    });

    // ---- the key selected on the circle
    function renderChords() {
      const chords = diatonicChords(current.pos, current.mode, sevenths);
      const labelled = chords.map((c) => {
        const info = chordInfo(c.letter, c.alter, findChord(c.chordId)!, 0);
        return { name: info.symbol, interval: c.roman };
      });
      const box = byId<HTMLElement>('chords');
      renderChips(box, labelled, (i) => {
        const c = chords[i];
        showChord(c.letter, c.alter, c.chordId);
        hear(diatonicChordMidis(c));
        [...box.children].forEach((el, k) => el.setAttribute('aria-pressed', String(k === i)));
        const circle = document.querySelector('.circle')!;
        const r = circle.getBoundingClientRect();
        if (r.top < 0 || r.bottom > innerHeight) circle.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }

    function select(pos: number, mode: Mode) {
      current = { pos, mode };
      const info = keyInfo(pos, mode);
      const other: Mode = mode === 'major' ? 'minor' : 'major';
      segs.forEach((s) => {
        const p = Number(s.dataset.pos);
        const m = s.dataset.mode;
        s.classList.toggle('sel', p === pos && m === mode);
        s.classList.toggle('rel', p === pos && m === other);
        s.classList.toggle('nbr', m === mode && (p === wrap(pos + 1) || p === wrap(pos - 1)));
        s.setAttribute('aria-pressed', String(p === pos && m === mode));
      });
      text('center-title', info.title);
      text('center-sig', info.signature.split(':')[0]);
      text('key-title', info.title);
      text('f-sig', info.signature);
      text('f-rel', info.relative);
      text('f-dom-label', mode === 'major' ? 'Dominant (V)' : 'Minor dominant (v)');
      text('f-sub-label', mode === 'major' ? 'Subdominant (IV)' : 'Subdominant (iv)');
      text('f-dom', info.dominant);
      text('f-sub', info.subdominant);
      renderChips(byId<HTMLElement>('scale'), info.scale);
      renderChords();
    }

    segs.forEach((s) => {
      const go = () => {
        select(Number(s.dataset.pos), s.dataset.mode === 'minor' ? 'minor' : 'major');
        hear(tonicMidis(current.pos, current.mode));
      };
      s.addEventListener('click', go);
      s.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          go();
        }
      });
    });

    const kindBtns = [...document.querySelectorAll<HTMLButtonElement>('#chord-kind [data-sevenths]')];
    kindBtns.forEach((b) =>
      b.addEventListener('click', () => {
        sevenths = b.dataset.sevenths === '1';
        kindBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        renderChords();
      }),
    );

    select(0, 'major');
    // no shape is drawn at first; the builder just starts on a C major triad
    fillQualities('triad');
    qualitySel.value = 'major';
    sizeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === 'triad')));
    drawShape();
  </script>
</Layout>
