---
import Layout from '../../layouts/Layout.astro';

// Blank sub-pages of Baroque (linked from the menu).
export function getStaticPaths() {
  return [{ params: { sub: 'bach' }, props: { title: 'Bach' } }];
}

const { title } = Astro.props;
---

<Layout title={title}>
  <main>
    <h1>{title}</h1>
  </main>
</Layout>
