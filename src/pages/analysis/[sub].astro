---
import Layout from '../../layouts/Layout.astro';

// Blank sub-pages of Analysis (linked from the menu).
export function getStaticPaths() {
  return [
    { params: { sub: 'bach-fugue' }, props: { title: 'Bach Fugue' } },
    { params: { sub: 'touhou' }, props: { title: 'Touhou' } },
  ];
}

const { title } = Astro.props;
---

<Layout title={title}>
  <main>
    <h1>{title}</h1>
  </main>
</Layout>
