---
import Layout from '../../../layouts/Layout.astro';
import { GAMES } from '../../../data/touhou';
import { bpmLabel, gameLabel, keysLabel, roleLabel } from '../../../scripts/touhou';

export function getStaticPaths() {
  return GAMES.map((game, i) => ({
    params: { game: game.id },
    props: { game, prev: GAMES[i - 1] ?? null, next: GAMES[i + 1] ?? null },
  }));
}

const { game, prev, next } = Astro.props;
---

<Layout title={`${gameLabel(game)} ${game.titleJa}`}>
  <main class="page-block wide">
    <p class="crumb"><a class="btn" href="/analysis/touhou/">← All Games</a></p>

    <h1>
      <span class="game-num">{gameLabel(game)}</span>
      <span lang="ja">{game.titleJa}</span>
    </h1>
    <p class="lead">{game.titleEn} · {game.year} · {game.tracks.length} tracks</p>

    <div class="track-head" aria-hidden="true">
      <span>No.</span>
      <span>Title</span>
      <span class="track-info"><span>Used in</span><span>BPM</span><span>Key</span></span>
    </div>
    <ol class="track-list">
      {
        game.tracks.map((t) => {
          const r = roleLabel(t);
          return (
            <li class="track">
              <span class="track-n">{t.n}</span>
              <span class="track-title" lang="ja">{t.title}</span>
              <span class="track-info">
                <span class="track-role">
                  {r.label}
                  {r.character && <span lang="ja" class="track-char"> · {r.character}</span>}
                </span>
                <span class="track-bpm" title="maximum bpm">{bpmLabel(t.bpm) || '–'}</span>
                <span class="track-key">{keysLabel(t.keys) || '–'}</span>
              </span>
            </li>
          );
        })
      }
    </ol>

    <p class="muted-line track-source">
      BPM and key come from the Touhou Music Database wiki on atwiki. The BPM is the maximum tempo it lists (two values when it
      lists two). Keys are named as the wiki names them, in the order they are heard; a dash means the wiki has no entry yet.
    </p>

    <nav class="game-nav" aria-label="Other games">
      {prev ? <a class="btn" href={`/analysis/touhou/${prev.id}/`}>← {gameLabel(prev)} <span lang="ja">{prev.titleJa}</span></a> : <span />}
      {next ? <a class="btn" href={`/analysis/touhou/${next.id}/`}>{gameLabel(next)} <span lang="ja">{next.titleJa}</span> →</a> : <span />}
    </nav>
  </main>
</Layout>
