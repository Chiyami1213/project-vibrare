---
// The analysis pages delivered as whole HTML files (src/static-pages/), shown inside the site's layout with the site's theme.
import Layout from '../../layouts/Layout.astro';
import { dropOwnTheme, listStaticPages, readStaticPage, rewriteLinks, routeOf, scopeCss, splitPage } from '../../lib/static-pages';

export function getStaticPaths() {
  return listStaticPages().map((url) => ({
    params: { spage: routeOf(url).slice('/analysis/'.length).replace(/\/$/, '') },
    props: { url },
  }));
}

const { url } = Astro.props;
const known = new Set(listStaticPages());
const page = splitPage(dropOwnTheme(rewriteLinks(readStaticPage(url), url, known)));
const css = scopeCss(page.css);
---

<Layout title={page.title} description={page.description || undefined}>
  <div class="sp" data-static-page>
    <style is:inline set:html={css} />
    <Fragment set:html={page.body} />
  </div>
</Layout>
