---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" noindex>
  <main class="page-block">
    <h1>Page Not Found</h1>
    <p class="lead">There is no page at this address. It may have moved, or the link may be mistyped.</p>
    <p class="btn-row">
      <a class="btn" href="/">Go to the Home Page</a>
      <a class="btn" href="/glossary/">Browse the Glossary</a>
    </p>
  </main>
</Layout>
