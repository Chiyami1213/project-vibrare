---
import Layout from '../layouts/Layout.astro';
import { INSTRUMENTS, INSTRUMENT_GROUPS } from '../scripts/instruments';
---

<Layout title="Settings">
  <main class="settings">
    <h1>Settings</h1>

    <h2 class="section-title">Appearance</h2>
    <div class="theme-tiles" role="group" aria-label="Appearance theme">
      <button class="theme-tile" type="button" data-theme-choice="light" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        Light
      </button>
      <button class="theme-tile" type="button" data-theme-choice="dark" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        Dark
      </button>
      <button class="theme-tile" type="button" data-theme-choice="device" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />
        </svg>
        Use Device Settings
      </button>
    </div>

    <h2 class="section-title">Audio</h2>
    <div class="audio-settings">
      <div class="field">
        <label class="field-label" for="volume">Volume <output id="volume-out" for="volume">80%</output></label>
        <input id="volume" class="volume-range" type="range" min="0" max="100" step="1" value="80" />
      </div>
      <div class="field">
        <span class="field-label" id="sound-label">Sound</span>
        <div class="seg-group" role="group" aria-labelledby="sound-label" id="sound-switch">
          <button type="button" class="seg-btn" data-muted="0" aria-pressed="true">On</button>
          <button type="button" class="seg-btn" data-muted="1" aria-pressed="false">Off</button>
        </div>
      </div>
      <div class="field">
        <span class="field-label" id="instrument-label">Instrument</span>
        <div id="instrument-switch" role="group" aria-labelledby="instrument-label">
          {
            INSTRUMENT_GROUPS.map((g) => (
              <div class="instrument-group">
                <span class="instrument-group-name">{g}</span>
                <div class="seg-group">
                  {INSTRUMENTS.filter((i) => i.group === g).map((i) => (
                    <button type="button" class="seg-btn" data-instrument={i.id} data-blurb={i.blurb} aria-pressed="false">{i.name}</button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <p id="instrument-blurb" class="muted-line"></p>
      </div>
      <div class="btn-row">
        <button type="button" class="btn" id="test-sound">▶ Play a Test Chord</button>
        <span id="test-status" class="muted-line" role="status"></span>
      </div>
    </div>

    <section class="help">
      <h2>Using This Site</h2>
      <ul>
        <li>
          On a computer, hover over the dark bar on the left to open the menu. On a phone, tap
          the menu button at the top left.
        </li>
        <li>
          Your theme choice is saved in this browser only. "Use Device Settings" follows your
          device's light or dark mode.
        </li>
        <li>
          The volume, the sound on/off setting and the instrument apply to every chord and score you play on the site,
          and are also saved in this browser only. The first time you play an instrument, its recordings (1 to 3 MB)
          are downloaded.
        </li>
      </ul>
    </section>
  </main>

  <script>
    const tiles = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');

    function saved(): string {
      try {
        const t = localStorage.getItem('theme');
        return t === 'light' || t === 'dark' ? t : 'device';
      } catch {
        return 'device';
      }
    }

    function show(choice: string) {
      tiles.forEach((t) =>
        t.setAttribute('aria-pressed', String(t.dataset.themeChoice === choice)),
      );
    }

    function apply(choice: string) {
      const root = document.documentElement;
      if (choice === 'device') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', choice);
      try {
        if (choice === 'device') localStorage.removeItem('theme');
        else localStorage.setItem('theme', choice);
      } catch {}
      show(choice);
    }

    tiles.forEach((t) => t.addEventListener('click', () => apply(t.dataset.themeChoice!)));
    show(saved());

    // ---- audio
    import { getAudioSettings, saveAudioSettings } from '../scripts/audio-settings';

    const volume = document.getElementById('volume') as HTMLInputElement;
    const volumeOut = document.getElementById('volume-out')!;
    const switches = [...document.querySelectorAll<HTMLButtonElement>('#sound-switch [data-muted]')];
    const instruments = [...document.querySelectorAll<HTMLButtonElement>('#instrument-switch [data-instrument]')];
    const instrumentBlurb = document.getElementById('instrument-blurb')!;

    function showAudio() {
      const a = getAudioSettings();
      volume.value = String(a.volume);
      volumeOut.textContent = `${a.volume}%`;
      switches.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.muted === '1') === a.muted)));
      instruments.forEach((b) => {
        const on = b.dataset.instrument === a.instrument;
        b.setAttribute('aria-pressed', String(on));
        if (on) instrumentBlurb.textContent = b.dataset.blurb ?? '';
      });
    }
    volume.addEventListener('input', () => {
      saveAudioSettings({ volume: Number(volume.value) });
      volumeOut.textContent = `${volume.value}%`;
    });
    switches.forEach((b) =>
      b.addEventListener('click', () => {
        saveAudioSettings({ muted: b.dataset.muted === '1' });
        showAudio();
      }),
    );
    instruments.forEach((b) =>
      b.addEventListener('click', () => {
        saveAudioSettings({ instrument: b.dataset.instrument });
        showAudio();
        void import('../scripts/sampler').then((m) => m.sampler.preload()); // start loading it at once
        document.getElementById('test-sound')!.click(); // let the visitor hear the choice straight away
      }),
    );
    const testStatus = document.getElementById('test-status')!;
    document.getElementById('test-sound')!.addEventListener('click', async () => {
      testStatus.textContent = 'Loading…';
      const { playChord } = await import('../scripts/synth');
      await playChord([48, 52, 55, 60], 'harmonic');
      testStatus.textContent = '';
    });
    showAudio();
  </script>
</Layout>
