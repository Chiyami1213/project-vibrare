---
import Layout from '../layouts/Layout.astro';

// Blank placeholder pages. They work by URL but are not in the menu yet.
// Add content here (or give a page its own file) when you're ready.
export function getStaticPaths() {
  const pages = [
    ['tonal-harmony', 'Tonal Harmony'],
    ['touhou-music', 'Touhou Music'],
    ['about', 'About Me'],
    ['career', 'Career'],
    ['projects', 'Projects'],
    ['coursework', 'Coursework'],
    ['rocketry', 'Rocketry'],
    ['music', 'Music'],
    ['documents', 'Documents'],
  ];
  return pages.map(([page, title]) => ({ params: { page }, props: { title } }));
}

const { title } = Astro.props;
---

<Layout title={title}>
  <main>
    <h1>{title}</h1>
  </main>
</Layout>
