---
import Layout from '../../layouts/Layout.astro';

// Blank sub-pages of Theory that have no sub-tabs of their own.
export function getStaticPaths() {
  return [
    { params: { sub: 'jazz' }, props: { title: 'Jazz' } },
    { params: { sub: 'music-history' }, props: { title: 'Music History' } },
    { params: { sub: 'hip' }, props: { title: 'Historically Informed Performance (HIP)' } },
  ];
}

const { title } = Astro.props;
---

<Layout title={title}>
  <main>
    <h1>{title}</h1>
  </main>
</Layout>
