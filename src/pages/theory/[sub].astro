---
import Layout from '../../layouts/Layout.astro';

// Blank sub-pages of Theory that have no sub-tabs of their own.
export function getStaticPaths() {
  return [{ params: { sub: 'tonal-harmony' }, props: { title: 'Tonal Harmony' } }];
}

const { title } = Astro.props;
---

<Layout title={title}>
  <main>
    <h1>{title}</h1>
  </main>
</Layout>
