---
import Layout from '../../../layouts/Layout.astro';

// Blank sub-pages of Partimento that are not built yet (Moti del Basso and Schemata have their own folders).
export function getStaticPaths() {
  return [
    { params: { sub: 'cadences' }, props: { title: 'Cadences' } },
    { params: { sub: 'rule-of-the-octave' }, props: { title: 'Rule of the Octave' } },
    { params: { sub: 'suspension' }, props: { title: 'Suspension' } },
    { params: { sub: 'diminution' }, props: { title: 'Diminution' } },
    { params: { sub: 'fugue' }, props: { title: 'Fugue' } },
  ];
}

const { title } = Astro.props;
---

<Layout title={title}>
  <main>
    <h1>{title}</h1>
  </main>
</Layout>
