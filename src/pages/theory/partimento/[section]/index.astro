---
import Layout from '../../../../layouts/Layout.astro';
import PatternOverview from '../../../../components/partimento/PatternOverview.astro';
import BackgroundPanels from '../../../../components/history/BackgroundPanels.astro';
import { SECTIONS, SECTION_TOOLS, groupsOf, patternsOf } from '../../../../data/partimento';

export function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props;
const count = patternsOf(section).length;
const tools = SECTION_TOOLS[section.slug] ?? [];
---

<Layout title={section.title}>
  <main class="page-block wide">
    <h1>{section.title}</h1>
    <p class="lead">{section.lead} {count} {count === 1 ? 'pattern' : 'patterns'}.</p>
    <PatternOverview groups={groupsOf(section)} />
    {
      tools.length > 0 && (
        <>
          <h2 class="section-title">Tools</h2>
          {tools.map((t) => <div class="tool-box" data-ptool={t.id} data-arg={t.arg}><h4 class="mini-title">{t.title}</h4></div>)}
        </>
      )
    }
    {section.slug === 'rule-of-the-octave' && <BackgroundPanels tab="partimento" at="rule-of-octave" />}
  </main>
</Layout>

<script>
  import { mountPartimentoTools } from '../../../../scripts/partimento/tools-mount';
  mountPartimentoTools();
</script>
