---
import Layout from '../../../layouts/Layout.astro';
import { BASE, CADENCES, MOTI_GROUPS, SCHEMATA_GROUPS, motiPatterns, schemataPatterns } from '../../../data/partimento';
import type { Group, Pattern } from '../../../data/partimento';
import { titleCase } from '../../../scripts/title-case';

const count = (groups: Group[], patterns: Pattern[]) =>
  groups.map((g) => ({ title: titleCase(g.title.replace(/^(Moti del basso|Schemata): /, '')), n: patterns.filter((p) => p.group === g.id).length }));

const sections = [
  {
    href: `${BASE}/moti-del-basso/`,
    title: 'Moti del Basso',
    blurb: 'The typical motions of the bass: stepwise lines rising and falling, chromatic laments, and sequences by leap.',
    patterns: motiPatterns.length,
    parts: count(MOTI_GROUPS, motiPatterns),
  },
  {
    href: `${BASE}/schemata/`,
    title: 'Schemata',
    blurb: 'Stock musical patterns, such as the Romanesca, Prinner, Folia and Monte, each pairing a bass with its upper voices.',
    patterns: schemataPatterns.length,
    parts: count(SCHEMATA_GROUPS, schemataPatterns),
  },
  {
    href: `${BASE}/cadences/`,
    title: 'Cadences',
    blurb: 'The cadence types and the clausulae behind them, in two, three and four parts.',
    patterns: CADENCES.patterns.length,
    parts: count(CADENCES.groups, CADENCES.patterns),
  },
];
// Sections added recently; their pages are being written.
const newer = [
  {
    href: `${BASE}/rule-of-the-octave/`,
    title: 'Rule of the Octave',
    blurb: 'A standard harmonization for each step of the scale in the bass, rising and falling, so a student could accompany any bass line in any key.',
  },
  {
    href: `${BASE}/suspension/`,
    title: 'Suspension',
    blurb: 'A note held over from the previous chord that clashes and then resolves downward, written in the figures as 7–6, 9–8 and 4–3.',
  },
  {
    href: `${BASE}/diminution/`,
    title: 'Diminution',
    blurb: 'Breaking long notes into shorter ones, with passing notes and figures, to turn a plain bass or harmony into a lively line.',
  },
  {
    href: `${BASE}/fugue/`,
    title: 'Fugue',
    blurb: 'Partimento fugues: a bass line that carries a fugue subject, which the student answers in the upper voices.',
  },
];
const total = sections.reduce((n, s) => n + s.patterns, 0);
---

<Layout title="Partimento">
  <main class="page-block wide">
    <h1>Partimento</h1>
    <p class="lead">
      A partimento is a bass line, figured or unfigured, that a student turned into a full piece at the keyboard,
      improvising the harmony and the upper voices above it. The practice grew up in the Italian conservatories of
      Naples in the 17th and 18th centuries and taught playing and composing together. Pupils learned it by absorbing
      stock patterns, which this section collects: {total} in all, many with scores you can play.
    </p>

    <ul class="pat-grid">
      {
        sections.map((s) => (
          <li class="pat-tile">
            <a href={s.href}>
              <span class="pat-name">{s.title}</span>
              <span class="pat-aka">{s.blurb}</span>
              <span class="pat-chips">
                <span class="chip chip-accent">{s.patterns} Patterns</span>
              </span>
              <span class="pat-aka">{s.parts.map((p) => `${p.title} (${p.n})`).join(' · ')}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="section-title">New Sections</h2>
    <p class="group-blurb">Recently added. These pages are still being written.</p>
    <ul class="pat-grid">
      {
        newer.map((s) => (
          <li class="pat-tile">
            <a href={s.href}>
              <span class="pat-name">{s.title}</span>
              <span class="pat-aka">{s.blurb}</span>
              <span class="pat-chips">
                <span class="chip chip-accent">New</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
