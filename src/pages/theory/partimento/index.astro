---
import Layout from '../../../layouts/Layout.astro';
import { BASE, SECTIONS, groupsOf, patternsOf } from '../../../data/partimento';
import { titleCase } from '../../../scripts/title-case';

const sections = SECTIONS.map((s) => {
  const patterns = patternsOf(s);
  return {
    href: `${BASE}/${s.slug}/`,
    title: s.title,
    blurb: s.lead.split('. ')[0].replace(/\.$/, '') + '.',
    patterns: patterns.length,
    examples: patterns.reduce((n, p) => n + (p.examples?.length ?? 0) + (p.variants ?? []).reduce((m, v) => m + (v.examples?.length ?? 0), 0), 0),
    parts: groupsOf(s).length > 1 ? groupsOf(s).map((g) => ({ title: titleCase(g.title.replace(/^(Moti del basso|Schemata): /, '')), n: patterns.filter((p) => p.group === g.id).length })) : [],
  };
});
const total = sections.reduce((n, s) => n + s.patterns, 0);
---

<Layout title="Partimento">
  <main class="page-block wide">
    <h1>Partimento</h1>
    <p class="lead">
      A partimento is a bass line, figured or unfigured, that a student turned into a full piece at the keyboard,
      improvising the harmony and the upper voices above it. The practice grew up in the Italian conservatories of
      Naples in the 17th and 18th centuries and taught playing and composing together. Pupils learned it by absorbing
      stock patterns, which this section collects: {total} in all, many with scores you can play.
    </p>

    <ul class="pat-grid">
      {
        sections.map((s) => (
          <li class="pat-tile">
            <a href={s.href}>
              <span class="pat-name">{s.title}</span>
              <span class="pat-aka">{s.blurb}</span>
              <span class="pat-chips">
                <span class="chip chip-accent">{s.patterns} {s.patterns === 1 ? 'Pattern' : 'Patterns'}</span>
                {s.examples > 0 && <span class="chip">{s.examples} Scores</span>}
              </span>
              {s.parts.length > 0 && <span class="pat-aka">{s.parts.map((p) => `${p.title} (${p.n})`).join(' · ')}</span>}
            </a>
          </li>
        ))
      }
      <li class="pat-tile">
        <a href={`${BASE}/fugue/`}>
          <span class="pat-name">Fugue</span>
          <span class="pat-aka">Partimento fugues: a bass line that carries a fugue subject, which the student answers in the upper voices.</span>
          <span class="pat-chips"><span class="chip chip-accent">New</span></span>
        </a>
      </li>
    </ul>
  </main>
</Layout>
