---
import Layout from '../../../../layouts/Layout.astro';
import PatternPage from '../../../../components/partimento/PatternPage.astro';
import { schemataPatterns } from '../../../../data/partimento';

export function getStaticPaths() {
  return schemataPatterns.map((pattern) => ({ params: { pattern: pattern.id }, props: { pattern } }));
}

const { pattern } = Astro.props;
---

<Layout title={pattern.name}>
  <PatternPage pattern={pattern} backHref="/theory/partimento/schemata/" backLabel="Schemata" />
</Layout>
