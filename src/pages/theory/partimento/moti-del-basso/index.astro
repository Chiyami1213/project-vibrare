---
import Layout from '../../../../layouts/Layout.astro';
import PatternOverview from '../../../../components/partimento/PatternOverview.astro';
import { MOTI_GROUPS, motiPatterns } from '../../../../data/partimento';
---

<Layout title="Moti del Basso">
  <main class="page-block wide">
    <h1>Moti del Basso</h1>
    <p class="lead">
      The typical motions of the bass in partimento, from stepwise lines to sequences. Choose a pattern to see how
      it is harmonized, with scores you can play. {motiPatterns.length} patterns.
    </p>
    <PatternOverview groups={MOTI_GROUPS} />
  </main>
</Layout>
