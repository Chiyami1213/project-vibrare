---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, WORKS } from '../../data/works';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: category.id }, props: { category } }));
}

const { category } = Astro.props;
const works = WORKS.filter((w) => w.category === category.id);
---

<Layout title={`${category.label} · Works`}>
  <main class="page-block wide">
    <p class="crumb"><a class="btn" href="/works/">← All Works</a></p>
    <h1>{category.label}</h1>

    {
      works.length === 0 ? (
        <p class="empty">Nothing here yet.</p>
      ) : (
        <ul class="res-list">
          {works.map((w) => (
            <li class="res-item">
              <div class="res-title">
                {w.title}
                {w.year && <span class="res-by"> · {w.year}</span>}
              </div>
              {w.original && <div class="res-note">Original: {w.original}</div>}
              {w.description && <div class="res-note">{w.description}</div>}
              {w.links && w.links.length > 0 && (
                <div class="res-note">
                  {w.links.map((l, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
                    </>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
