---
import '../styles/global.css';
import '../styles/content-pages.css';
import MenuItem from '../components/MenuItem.astro';
import { CATEGORIES } from '../data/works';
import type { MenuLink } from '../components/MenuItem.astro';

interface Props {
  title?: string;
  /** one or two sentences for search results and link previews; a default is built from the title */
  description?: string;
  noindex?: boolean;
}

const SITE = 'Vibrare';
const SITE_DESCRIPTION =
  'Vibrare is a music study archive: tonal harmony, partimento, counterpoint, fugue, historically informed performance, analysis and interactive music tools.';
const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE}` : `${SITE}: Music Theory, Partimento, Counterpoint and Fugue`;
const metaDescription = description ?? (title ? `${title}. ${SITE_DESCRIPTION}` : SITE_DESCRIPTION);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://vibrare.pages.dev').href;
const isHome = Astro.url.pathname === '/';

// Menu: adding an item is one entry in `top` or `bottom`
// (`icon` is a key of ICONS in components/MenuItem.astro; `children` makes sub-tabs).
const top: MenuLink[] = [
  { href: '/', label: 'Home', icon: 'home' },
  {
    href: '/theory/',
    label: 'Theory',
    icon: 'theory',
    children: [
      { href: '/theory/tonal-harmony/', label: 'Tonal Harmony', icon: 'waves' },
      {
        href: '/theory/partimento/',
        label: 'Partimento',
        icon: 'score',
        children: [
          { href: '/theory/partimento/moti-del-basso/', label: 'Moti del Basso', icon: 'stairs' },
          { href: '/theory/partimento/schemata/', label: 'Schemata', icon: 'grid' },
          { href: '/theory/partimento/cadences/', label: 'Cadences', icon: 'resolve' },
          { href: '/theory/partimento/rule-of-the-octave/', label: 'Rule of the Octave', icon: 'stairs' },
          { href: '/theory/partimento/suspension/', label: 'Suspension', icon: 'resolve' },
          { href: '/theory/partimento/diminution/', label: 'Diminution', icon: 'dots' },
          { href: '/theory/partimento/fugue/', label: 'Fugue', icon: 'entries' },
        ],
      },
      { href: '/theory/counterpoint/', label: 'Counterpoint', icon: 'weave' },
      { href: '/theory/jazz/', label: 'Jazz', icon: 'sax' },
      { href: '/theory/music-history/', label: 'Music History', icon: 'clock' },
      { href: '/theory/hip/', label: 'HIP', icon: 'music' },
    ],
  },
  {
    href: '/analysis/',
    label: 'Analysis',
    icon: 'analysis',
    children: [
      {
        href: '/analysis/baroque/',
        label: 'Baroque',
        icon: 'lute',
        children: [
          { href: '/analysis/baroque/bach/', label: 'Bach', icon: 'organ' },
          { href: '/analysis/baroque/quantz/', label: 'Quantz', icon: 'flute' },
          { href: '/analysis/baroque/blavet/', label: 'Blavet', icon: 'flute' },
        ],
      },
      { href: '/analysis/touhou/', label: 'Touhou Project', icon: 'yinyang' },
      { href: '/analysis/japanese-music/', label: 'Japanese Music', icon: 'torii' },
    ],
  },
  {
    href: '/tools/',
    label: 'Tools',
    icon: 'tools',
    children: [
      { href: '/tools/interval-calculator/', label: 'Interval Calculator', icon: 'interval' },
      { href: '/tools/scale-calculator/', label: 'Scale Calculator', icon: 'keys' },
      { href: '/tools/chord-calculator/', label: 'Chord Calculator', icon: 'chord' },
      { href: '/tools/circle-of-fifths/', label: 'Circle of Fifths', icon: 'cof' },
      { href: '/tools/satb/', label: 'SATB', icon: 'group' },
    ],
  },
  {
    href: '/works/',
    label: 'Works',
    icon: 'disc',
    children: CATEGORIES.map((c) => ({ href: `/works/${c.id}/`, label: c.label, icon: c.icon })),
  },
  { href: '/glossary/', label: 'Glossary', icon: 'book' },
  { href: '/resources/', label: 'Resources', icon: 'bookmark' },
];
const bottom: MenuLink[] = [
  { href: '/about/', label: 'About', icon: 'info' },
  { href: '/settings/', label: 'Settings', icon: 'settings' },
];

const path = Astro.url.pathname;

// Drill-down menu: on a page inside a top-level tab that has sub-tabs, the menu shows that
// tab (with its sub-tabs) instead of the main list. The back arrow returns to the main list.
const norm = (p: string) => p.replace(/\/$/, '') || '/';
const inside = (href: string) => norm(path) === norm(href) || norm(path).startsWith(norm(href) + '/');
// A view for every item that has sub-tabs: the top-level tabs (back to the main list), and the sub-tabs that have
// sub-tabs of their own, such as Partimento (back to Theory).
interface MenuView {
  id: string;
  item: MenuLink;
  parentId: string;
  parentLabel: string;
}
const views: MenuView[] = top
  .filter((i) => i.children?.length)
  .flatMap((s) => [
    { id: s.href, item: s, parentId: 'main', parentLabel: 'Main menu' },
    ...s.children!.filter((c) => c.children?.length).map((c) => ({ id: c.href, item: c, parentId: s.href, parentLabel: s.label })),
  ]);
// the deepest view that holds the current page
const currentView = views.filter((v) => inside(v.id)).sort((a, b) => b.id.length - a.id.length)[0];
const initialView = currentView ? currentView.id : 'main';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE, url: canonical, description: SITE_DESCRIPTION })} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Runs before first paint: apply saved theme and start the opening animation
      // (first visit of a browser session, and on every reload).
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
        var show = false;
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          var reload = !!nav && nav.type === 'reload';
          if (!sessionStorage.getItem('vibrare-seen') || reload) show = true;
          sessionStorage.setItem('vibrare-seen', '1');
        } catch (e) {}
        if (show) {
          d.classList.add('loading');
          setTimeout(function () { d.classList.add('open'); }, 250);
          setTimeout(function () { d.classList.remove('loading', 'open'); }, 1300);
        }
      })();
    </script>
  </head>
  <body>
    <div id="loader" aria-hidden="true">
      <div class="panel panel-l"></div>
      <div class="panel panel-r"></div>
    </div>

    <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="rail">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
    <div class="backdrop" hidden></div>

    <nav id="rail" class="rail" aria-label="Main menu">
      <div class="view" data-view-id="main" hidden={initialView !== 'main'}>
        <ul class="rail-top">
          {top.map((i) => <MenuItem item={i} path={path} levels={1} />)}
        </ul>
        <ul class="rail-bottom">
          {bottom.map((i) => <MenuItem item={i} path={path} />)}
        </ul>
      </div>
      {
        views.map((v) => (
          <div class="view view-section" data-view-id={v.id} data-parent={v.parentId} hidden={initialView !== v.id}>
            <ul class="rail-top">
              <li class="back-item">
                <button type="button" class="back" aria-label={`Back to ${v.parentLabel.toLowerCase()}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                  </svg>
                  <span class="label">{v.parentLabel}</span>
                </button>
              </li>
              <MenuItem item={v.item} path={path} />
            </ul>
            <ul class="rail-bottom">
              {bottom.map((i) => <MenuItem item={i} path={path} />)}
            </ul>
          </div>
        ))
      }
    </nav>

    <div class="page">
      <slot />
      <footer class="site-footer">
        <span>&copy; Project Vibrare 2026</span>
        <nav class="footer-links" aria-label="Links">
          <a href="https://www.youtube.com/@chiyami1213" target="_blank" rel="noopener noreferrer" aria-label="YouTube channel" title="youtube channel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg>
          </a>
          <a href="https://chiyami.pages.dev/" target="_blank" rel="noopener noreferrer" aria-label="Personal website" title="personal website">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </a>
        </nav>
      </footer>
    </div>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      const backdrop = document.querySelector<HTMLElement>('.backdrop')!;
      const rail = document.getElementById('rail')!;
      function setOpen(open: boolean) {
        rail.classList.toggle('drawer-open', open);
        backdrop.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      }
      // Back arrow: show the main list again (no page change).
      function showView(id: string) {
        rail.querySelectorAll<HTMLElement>('.view').forEach((v) => (v.hidden = v.dataset.viewId !== id));
      }
      rail.querySelectorAll<HTMLButtonElement>('.back').forEach((b) =>
        b.addEventListener('click', () => {
          const view = b.closest<HTMLElement>('.view')!;
          const parent = view.dataset.parent ?? 'main';
          showView(parent);
          // keep keyboard focus in the menu: land on the tab we just left
          rail.querySelector<HTMLAnchorElement>(`.view[data-view-id="${parent}"] a[href="${view.dataset.viewId}"]`)?.focus();
        }),
      );
      btn.addEventListener('click', () => setOpen(!rail.classList.contains('drawer-open')));
      backdrop.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
    </script>
  </body>
</html>
